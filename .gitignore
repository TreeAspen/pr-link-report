# ---- 源报告 PDF ----------------------------------------------------------
# 客户的传播报告，不入库
*.pdf

# ---- 由脚本生成的产物 ----------------------------------------------------
# logos.js / logos/ 里是从传播报告中提取的第三方媒体 Logo，
# sample.js 里含具体客户的新闻稿内容与配图。
# 两者都由脚本从你自己的报告 PDF 现场生成，不随仓库分发。
logos.js
logos/
logos_manifest.json
sample.js

